<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Dominio canónico (sin www): los requests de path relativo resuelven aquí,
             así el middleware RedirectToCanonicalDomain no los 301-redirige. El .env
             de desarrollo aún trae www; sin fijarlo aquí, toda la suite de API caería. -->
        <env name="APP_URL" value="https://fronda.app"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <!-- Ninguna de estas lleva force="true", así que una variable de entorno ya
             definida gana. Sirve para algo concreto: dos suites corriendo a la vez
             sobre la misma base se pisan el esquema, y el síntoma no se parece a la
             causa — tablas que «no existen» a mitad de un test, columnas que faltan,
             y un «deadlock detected» sobre el DROP TABLE que hace RefreshDatabase.
             Para no chocar, cada uno corre contra la suya:

                 DB_DATABASE=artemis_test_loquesea php artisan test

             La base hay que crearla antes; las migraciones las pone la suite. -->
        <env name="DB_DATABASE" value="artemis_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres123"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
